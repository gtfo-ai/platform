# Environment variables — docs/technical/12-configuration-and-schemas.md, TD-020.
#
# Naming: standard 12-factor names stay unprefixed; platform settings use the
# neutral APP_ prefix (BD-014); integration credentials keep the names the bundled
# CLIs read. Every secret also accepts a <NAME>_FILE variant holding a path to a
# file with the value (Docker secrets convention) — the _FILE variant wins.
#
# NEVER put a real value in this file (BD-002). Copy it to .env for local work;
# .env is git-ignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
# Which workloads this process runs (technical/01): all | api | worker | runner |
# indexer. One image, several containers. Every role serves /healthz, /readyz,
# /metrics and /api/version — a worker container has to be probeable too — and
# `api` is what publishes the authenticated API, the SSE stream and the OpenAPI
# document. `runner` and `indexer` are named by the architecture but their
# workloads land in WP-12 and WP-16; setting them today starts a process that
# says so in a warning and then serves only the ops endpoints.
ROLE=all
PORT=8080
# Interface to bind. 0.0.0.0 inside a container; 127.0.0.1 to expose nothing.
HOST=0.0.0.0
# Holds a password, so it also accepts the _FILE variant.
DATABASE_URL=postgres://app:app@db:5432/app
DATABASE_URL_FILE=
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=json
TZ=UTC
# Set true when a reverse proxy terminates TLS in front of the app, so
# X-Forwarded-For and X-Forwarded-Proto are believed. Leave false when the app is
# reachable directly: a client can otherwise forge its own address.
APP_TRUST_PROXY=false
# Largest request body accepted, in bytes.
APP_HTTP_BODY_LIMIT_BYTES=1048576
# How long a graceful shutdown may take before the process exits anyway. The
# order is: /readyz answers 503, the SSE streams get an `event: shutdown` and are
# drained, in-flight requests finish, the workers stop, the pool closes.
APP_SHUTDOWN_TIMEOUT_MS=30000
# Build metadata, reported by GET /api/version. Stamped into the image at build
# time (WP-22); empty in a checkout, where the version reads 0.0.0-dev.
APP_VERSION=
APP_COMMIT=
APP_BUILT_AT=

# ── Platform ─────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
# Session signing and encryption of integration secrets at rest. Secret, no default.
# Generate with: openssl rand -base64 48
APP_SECRET_KEY=
APP_SECRET_KEY_FILE=
# api | local  (BD-004)
APP_PROVIDER_MODE=api
APP_WORKSPACE_ROOT=/var/lib/app/workspaces
# db | fs:<path> | s3:<bucket>
APP_TRANSCRIPT_STORE=db
APP_RUNNER_MAX_PARALLEL=4
# Set only when webhooks can reach this instance; otherwise the platform polls.
APP_WEBHOOK_PUBLIC_URL=
APP_DISABLE_TELEMETRY=true
# Path to a claude binary, used in APP_PROVIDER_MODE=local.
APP_CLAUDE_BINARY=

# Feature flags for staged rollout (APP_FEATURE_*, technical/12). Every flag is
# off unless set to true; the instance-wide value is the ceiling for what a
# project may enable in .agentic/config.yml.
APP_FEATURE_TICKET_LINTER=false
APP_FEATURE_REVIEW_ONLY=false
APP_FEATURE_MAINTENANCE=false
APP_FEATURE_SHADOW_MODE=false
APP_FEATURE_DIGEST=true

# ── Authentication and sessions (TD-022) ─────────────────────────────────────
# Open registration. Off by default: a self-hosted instance reachable from the
# internet is not a sign-up page. With it on, a new account gets the `member`
# role; administrators are made by an administrator.
APP_ALLOW_SIGNUP=false
# The first administrator, created at boot when the instance has no users at all
# (Q39). Leave both empty on an instance that already has users — they are then
# ignored. With no users and no bootstrap account configured, the server starts
# and warns that nobody can sign in.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_NAME=Administrator
# Secret. Required whenever APP_BOOTSTRAP_ADMIN_EMAIL is set; at least 12
# characters. Change it after the first sign-in.
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# Session lifetime in days. Sliding: a session in daily use is extended, an
# abandoned one expires. Sessions live in the database and are revocable.
APP_SESSION_TTL_DAYS=7
# Argon2id parameters (OWASP defaults). Each concurrent login allocates
# APP_ARGON2_MEMORY_KIB kibibytes, so lower the memory on a small host rather
# than lowering the time cost.
APP_ARGON2_MEMORY_KIB=19456
APP_ARGON2_TIME_COST=2
APP_ARGON2_PARALLELISM=1

# ── Real-time stream (TD-014, technical/08) ──────────────────────────────────
# Frames kept per topic for replay after a reconnect. A client that reconnects
# with a position older than this is told to refetch (`event: reset`) rather than
# being given a silently incomplete stream, so raising it trades memory for
# fewer refetches.
APP_SSE_BUFFER_SIZE=256
# How far one stream's write queue may grow beyond the depth it opened at before
# that client is treated as a stalled reader and the stream is dropped.
# Deliberately separate from the buffer size, and deliberately a measure of
# growth rather than of depth: a replay batch is queued in full when the stream
# opens, so a depth cap reads a large reconnect as a slow consumer and closes a
# healthy stream. Tying the two together once made every multi-topic reconnect
# deliver nothing at all. The headroom a large reconnect buys does not decay, so
# one stream's queue is bounded by APP_SSE_BUFFER_SIZE x APP_SSE_MAX_TOPICS plus
# this: 16832 frames, 11109120 bytes, 10.59 MiB at the ceiling, against 330 KiB
# for this value alone. It is transient — the stream is dropped when the bound is
# crossed, and its queue becomes unreachable with it.
APP_SSE_MAX_QUEUED_FRAMES=512
# Topics one stream may carry. It bounds the largest replay a single reconnect
# can ask for: APP_SSE_BUFFER_SIZE x this many frames, at roughly 660 bytes a
# frame, so 16384 frames = 10813440 bytes = 10.31 MiB per stream at these
# defaults, and 10.07 GiB if 1000 streams each held full buffers on topics of
# their own. That is a bound, not a safe value: raising this raises that product,
# so lower APP_SSE_BUFFER_SIZE to match.
APP_SSE_MAX_TOPICS=64
# Topics whose replay buffer is retained, least-recently-published evicted first.
# Topics are per task and per run and nothing tells the server when a run ends,
# so this is what actually bounds the figure above: 1024 x APP_SSE_BUFFER_SIZE x
# 660 bytes is 173015040 bytes, which is exactly 165 MiB. Evicting a buffer
# costs a reconnecting client its replay and gives it `event: reset` instead.
APP_SSE_MAX_BUFFERED_TOPICS=1024
# `: ping` comment interval, in milliseconds.
APP_SSE_PING_INTERVAL_MS=20000
# The `retry:` interval sent to clients, in milliseconds.
APP_SSE_RETRY_MS=1000
# Hard cap on simultaneous streams, so a client reconnect loop cannot exhaust the
# process's sockets. Note browsers allow 6 connections per origin on HTTP/1.1;
# terminate HTTP/2 in the reverse proxy for more tabs per user.
APP_SSE_MAX_CONNECTIONS=1000
# How long shutdown waits for one stream's queued frames to reach the socket
# before closing it anyway. Unbounded, a single reader that has stopped reading
# would hold the whole graceful shutdown until APP_SHUTDOWN_TIMEOUT_MS killed the
# process, and every shutdown step behind the SSE drain would never run.
# Must be strictly less than APP_SHUTDOWN_TIMEOUT_MS -- this is one step inside
# that budget, and the steps behind it need what is left of it. The server
# refuses to start otherwise.
APP_SSE_SHUTDOWN_DRAIN_MS=5000

# ── Observability (TD-023) ───────────────────────────────────────────────────
# Optional basic auth on /metrics. Set both or neither: a username with no
# password is a check that always fails, and a password with no username is one
# that is never applied. The password also accepts the _FILE variant.
APP_METRICS_USERNAME=
APP_METRICS_PASSWORD=
APP_METRICS_PASSWORD_FILE=

# ── Database (technical/03) ──────────────────────────────────────────────────
# Least-privilege role every runtime connection starts as. Migrations create it
# and grant it SELECT everywhere, plus INSERT on all but event_streams, plus
# UPDATE/DELETE only on the mutable tables. So: read-only on event_streams
# (the event log's sequence counter, which a database trigger maintains);
# append-only on events, run_messages, cost_entries, integration_actions,
# config_audit, redaction_log and human_actions; read/write on the rest. That is
# what makes the REVOKE bite even when the app connects as the database owner.
# The role is set in the connection's startup packet, so a pooler that rejects
# startup options (pgbouncer in transaction mode) needs this left empty and a
# login role that already carries the right grants.
APP_DB_APP_ROLE=platform_app
# Maximum pooled connections per process. The event dispatcher holds TWO at
# once per concurrent dispatch — the transaction that owns the event's queue row
# for the length of the dispatch, and the handler's transaction running inside
# it — so this must be at least 2 * APP_DISPATCH_MAX_CONCURRENCY + 1. Start-up
# refuses anything below that rather than deadlocking on it. That figure is the
# floor for dispatch alone, though: the same pool serves API queries and
# notifications, so size above it in a real deployment.
#
# apps/server adds its own floor on top of the dispatcher's, per workload the
# ROLE actually starts — pg-boss's workers and cron (+2), the pipeline's stage
# and review-window workers (+2), concurrent HTTP request queries (+2) and
# readiness/maintenance (+1) — and refuses to start below it, because a pool
# sized at exactly the dispatcher's floor passes that check and then stalls the
# first time a request and a sweep want a connection together.
# A dispatch holds THREE connections, not two: the dispatcher's transaction, the
# handler's, and the audit row an outbound provider call writes from inside the
# handler's transaction (BD-003). That third one is per in-flight dispatch, so it
# scales with APP_DISPATCH_MAX_CONCURRENCY below.
# With the defaults here (ROLE=all, concurrency 1) the floor is 11, and 13 leaves
# the same two connections of slack the previous default did. It is a floor plus
# slack, never a capacity plan: size above it for real traffic.
APP_DB_POOL_MAX=13
# How long a caller waits for a free pooled connection before failing. Without
# it the pg driver waits for ever, so a pool too small for the work in flight
# hangs silently instead of erroring. A failed dispatch leaves its event queued,
# so a bounded wait costs a retry, never an event.
APP_DB_CONNECTION_TIMEOUT_MS=10000
# How many months of monthly partitions to keep ahead of the current one. The
# migrate service and the daily maintenance job both use it.
APP_DB_PARTITION_MONTHS_AHEAD=3
# Transcript retention in days. Empty (the default) keeps everything forever;
# a value drops whole run_messages partitions older than it. Metadata,
# artifacts, events and cost are never dropped. This variable is the source of
# truth: migrate writes it into the database on every run, so editing the stored
# value by hand is reverted on the next start.
APP_TRANSCRIPT_RETENTION_DAYS=

# ── Event dispatch (TD-005, TD-014) ──────────────────────────────────────────
# Events an outbox sweep reads at a time. At most one per stream, so this bounds
# how many streams move in parallel, not how deep the queue is drained.
APP_DISPATCH_BATCH_SIZE=32
# Dispatches in flight at once. Each holds three pooled connections — its own
# transaction, the handler's, and the audit row a provider call writes from
# inside the handler's — so APP_DB_POOL_MAX must be at least 3 * this + 1 (the
# sweep needs one to read with) plus the reservations above. Raising it needs
# the pool raised with it.
APP_DISPATCH_MAX_CONCURRENCY=1
# Longest an idle worker waits before sweeping again. Every process runs this
# timer itself and always arms it: appending an event sends a NOTIFY that wakes
# that process's own subscription immediately, and this poll is the fallback for
# *that* subscription, so nothing cluster-wide (a cron job, another replica) can
# stand in for it. Raise it to cut idle queries, lower it if NOTIFY cannot reach
# this process. Every replica polls the one queue, which is cheap: the claim is
# FOR UPDATE SKIP LOCKED, so concurrent sweeps never block one another.
APP_DISPATCH_POLL_INTERVAL_MS=1000
# Retry backoff after a handler fails: the first retry waits this long, each
# further attempt twice as long, capped by the maximum. The event's whole stream
# waits behind it, which is what keeps effects ordered per stream.
APP_DISPATCH_RETRY_DELAY_MS=5000
APP_DISPATCH_MAX_RETRY_DELAY_MS=300000
# How long a graceful shutdown waits for in-flight dispatches before reporting
# what is still running. Nothing is dropped either way; an unfinished event stays
# queued for the next process.
APP_DISPATCH_DRAIN_TIMEOUT_MS=30000
# LISTEN/NOTIFY channel used for real-time fan-out between app instances. A bare
# lower-case identifier. Change it only to run two instances against one database.
APP_BROADCAST_CHANNEL=platform_broadcast

# ── Jobs, timers and cron (TD-004) ───────────────────────────────────────────
# pg-boss lives in the same database, in its own schema, installed by the
# migrate service. Change this only if migrate was run with a different schema:
# the runtime never installs or upgrades it (TD-019).
APP_JOBS_SCHEMA=pgboss
# How often a worker looks for work when nothing wakes it, in seconds.
# pg-boss's floor is 0.5.
APP_JOBS_POLL_INTERVAL_SECONDS=2
# How often the cron table is re-read, in seconds (1-45). Lower makes a newly
# registered schedule take effect sooner and costs one small query per interval.
APP_JOBS_CRON_INTERVAL_SECONDS=30

# ── Working calendar (question timeouts, reminders, digests) ─────────────────
# `1 working day` in .agentic/config.yml is resolved on this calendar (BD-006,
# Q8, Q36). It seeds the organisation setting; a project never overrides it,
# because working days are an organisational fact, not a repository one.
# The zone comes from TZ above and defaults to UTC — never to the host clock.
#
# ISO weekday numbers, Monday = 1 … Sunday = 7.
APP_WORKING_DAYS=1,2,3,4,5
# The window inside a working day, HH:MM-HH:MM, read in TZ.
APP_WORKING_HOURS=09:00-17:00
# Comma-separated YYYY-MM-DD dates with no working time. Empty by default: the
# platform never guesses a country's public holidays.
APP_HOLIDAYS=

# ── Claude ───────────────────────────────────────────────────────────────────
# Secret. Required in APP_PROVIDER_MODE=api. Passed only to the runner process.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
# Secret. Optional, APP_PROVIDER_MODE=local only.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_FILE=
# Set on runner processes.
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
DISABLE_AUTOUPDATER=1

# ── Launcher (`ROLE=launcher`, TD-021) ───────────────────────────────────────
# The only component that reaches the Docker daemon. `DOCKER_HOST` keeps the
# tool-native name (TD-020) so a compose file points the CLI and the launcher at
# the same place; only two forms are accepted, and anything else is a startup
# error rather than a silent fallback to the local socket:
#   unix:///var/run/docker.sock   the daemon directly
#   tcp://docker-socket-proxy:2375  the filtered proxy TD-021 deploys
DOCKER_HOST=unix:///var/run/docker.sock
# The shared control volume (TD-025 §2) and where the *runner* has it mounted.
# One sub-directory per run; the socket path built from it must stay under 103
# bytes, which is what a Unix socket address can hold.
APP_WORKSPACE_CONTROL_VOLUME=agentic-ctl
APP_WORKSPACE_CONTROL_ROOT=/run/agentic/ctl
# One bare mirror per project, cloned with `--shared` by every run, so it must
# not be garbage-collected while a workspace references it.
APP_WORKSPACE_CACHE_VOLUME=agentic-repo-cache
# Images. `platform-runtime` and `platform-egress` land with WP-22; the git image
# runs the mirror, clone and export helpers, which the launcher itself cannot.
APP_WORKSPACE_RUNTIME_IMAGE=platform-runtime:latest
APP_WORKSPACE_EGRESS_IMAGE=platform-egress:latest
APP_WORKSPACE_GIT_IMAGE=alpine/git:v2.49.1
# **Development only, and WP-22 removes it.** Absolute path of a checkout of this
# repository, mounted read-only at /repo in every run container so the run shim
# can be started from TypeScript source until `platform-runtime` exists. Empty in
# production: with it unset a run container has no host mount at all. Setting it
# logs a warning at startup.
APP_WORKSPACE_RUNTIME_SOURCE_DIR=
# The network the mirror and export helpers use to reach the git host, and the
# network the egress sidecar is attached to besides the run's own internal one.
APP_WORKSPACE_HELPER_NETWORK=bridge
APP_WORKSPACE_EGRESS_NETWORK=bridge
# Where take-over export tarballs are written, and the ceiling on one.
APP_WORKSPACE_EXPORT_DIR=/var/lib/app/exports
APP_WORKSPACE_MAX_EXPORT_BYTES=134217728
# How often the retention sweep runs (technical/05 §5 keeps a workspace volume
# 3 days by default, 14 for a paused or taken-over task).
APP_WORKSPACE_RETENTION_SWEEP_MS=3600000

# ── Run shim `agentic-runlet` (TD-025) ───────────────────────────────────────
# These are read **inside the run container**, not by the platform. The launcher
# (WP-14) renders them per run; an operator normally never sets one, and they are
# listed here because anyone debugging a run container will meet them. They are
# tool-native rather than APP_* for the same reason the integration credentials
# are (TD-020): the runlet is a bundled CLI in a different image.
#
# The two Unix sockets on the per-run directory of the `ctl` volume. The first is
# the runner's single authenticated control connection; the second is where the
# workspace's git credential helper asks for a token. Leave the second unset to
# run with no credential channel at all.
RUNLET_CONTROL_SOCKET=/ctl/ctl.sock
RUNLET_CREDENTIAL_SOCKET=/ctl/cred.sock
# The per-run token. Secret, so it takes the _FILE variant, and the file is what
# the launcher should use: `/proc/<pid>/environ` is readable by every process in
# the container, a file on /ctl is one path the launcher controls. Neither hides
# it from the agent — nothing inside one container can — see the note at the top
# of packages/infrastructure/src/runlet/shim.ts. Empty or blank is refused at
# startup; the shim does not listen without a real token.
RUNLET_TOKEN=
RUNLET_TOKEN_FILE=
# SIGTERM, then this long, then SIGKILL, when the control connection drops.
RUNLET_KILL_GRACE_MS=10000
# A connection that has not authenticated in this long is dropped.
RUNLET_HANDSHAKE_TIMEOUT_MS=30000
# How long the runner has to answer a credential request before the helper is
# told there is none.
RUNLET_CREDENTIAL_TIMEOUT_MS=30000
# How many credentials one run may ask for, in total.
RUNLET_MAX_CREDENTIAL_REQUESTS=32
# The uid/gid to drop to when starting the CLI. Only needed when the shim itself
# runs as root — it refuses to start the agent's CLI as root without them.
RUNLET_CHILD_UID=
RUNLET_CHILD_GID=
# debug | info | warn | error | silent. NDJSON on stderr, pino's shape.
RUNLET_LOG_LEVEL=info

# ── Integration credentials (tool-native names, TD-020) ──────────────────────
# All secret; all optional until the matching integration is configured.
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=
GITLAB_TOKEN_FILE=
JIRA_SITE=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_API_TOKEN_FILE=
# The webhook's secret token (Jira shows it once, when the webhook is created).
# Empty means this binding has no webhook: it is polled instead, and every inbound
# delivery is rejected rather than accepted unverified.
JIRA_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET_FILE=
# Socket Mode only: the app-level token (xapp-), scope connections:write.
SLACK_APP_TOKEN=
SLACK_APP_TOKEN_FILE=
# The bot token (xoxb-) every Web API call authenticates with.
SLACK_BOT_TOKEN=
SLACK_BOT_TOKEN_FILE=
# The app's signing secret. Required even in Socket Mode: the interactivity and events HTTP
# paths exist either way, and a binding that cannot verify a delivery rejects every one rather
# than accepting it unverified. Empty or whitespace means "unset", never "accept anything".
SLACK_SIGNING_SECRET=
SLACK_SIGNING_SECRET_FILE=
# Sentry: the instance root and the organization slug the binding reads, plus the auth token.
# Scopes: event:read, event:write, org:read (see the provider's setup guide).
SENTRY_URL=https://sentry.io
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
SENTRY_AUTH_TOKEN_FILE=
# Loki: the server address, and the credential for whichever auth_mode the binding declares.
# Empty with auth_mode bearer|basic is a refusal, not an anonymous query (standing rule 18).
# LOKI_ORG_ID is the X-Scope-OrgID tenant; leave it empty on a single-tenant instance.
# With auth_mode basic, logcli's own names carry the pair; the password is a secret, the
# username is not (TD-020: tool-native names, _FILE variants for secrets).
LOKI_ADDR=
LOKI_BEARER_TOKEN=
LOKI_BEARER_TOKEN_FILE=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_PASSWORD_FILE=
LOKI_ORG_ID=

# ── Web app, development only (WP-20) ────────────────────────────────────────
# `pnpm dev` starts apps/server and the Vite dev server side by side. The dev
# server proxies /api and /events to the API so the browser sees one origin, the
# way the packaged image serves it. Nothing here is read in production: the built
# bundle is served by the app process itself and uses relative URLs.
APP_DEV_API_URL=http://127.0.0.1:8080
APP_DEV_WEB_PORT=5173

# ── CI budgets (used by evals.yml / nightly-llm.yml) ─────────────────────────
EVAL_MAX_USD=5
LLM_CI_MAX_USD=10

# Environment variables — docs/technical/12-configuration-and-schemas.md, TD-020.
#
# Naming: standard 12-factor names stay unprefixed; platform settings use the
# neutral APP_ prefix (BD-014); integration credentials keep the names the bundled
# CLIs read. Every secret also accepts a <NAME>_FILE variant holding a path to a
# file with the value (Docker secrets convention) — the _FILE variant wins.
#
# NEVER put a real value in this file (BD-002). Copy it to .env for local work;
# .env is git-ignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
# Holds a password, so it also accepts the _FILE variant.
DATABASE_URL=postgres://app:app@db:5432/app
DATABASE_URL_FILE=
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=json
TZ=UTC

# ── Platform ─────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
# Session signing and encryption of integration secrets at rest. Secret, no default.
# Generate with: openssl rand -base64 48
APP_SECRET_KEY=
APP_SECRET_KEY_FILE=
# api | local  (BD-004)
APP_PROVIDER_MODE=api
APP_WORKSPACE_ROOT=/var/lib/app/workspaces
# db | fs:<path> | s3:<bucket>
APP_TRANSCRIPT_STORE=db
APP_RUNNER_MAX_PARALLEL=4
# Set only when webhooks can reach this instance; otherwise the platform polls.
APP_WEBHOOK_PUBLIC_URL=
APP_DISABLE_TELEMETRY=true
# Path to a claude binary, used in APP_PROVIDER_MODE=local.
APP_CLAUDE_BINARY=

# Feature flags for staged rollout (APP_FEATURE_*, technical/12). Every flag is
# off unless set to true; the instance-wide value is the ceiling for what a
# project may enable in .agentic/config.yml.
APP_FEATURE_TICKET_LINTER=false
APP_FEATURE_REVIEW_ONLY=false
APP_FEATURE_MAINTENANCE=false
APP_FEATURE_SHADOW_MODE=false
APP_FEATURE_DIGEST=true

# ── Database (technical/03) ──────────────────────────────────────────────────
# Least-privilege role every runtime connection starts as. Migrations create it
# and grant it SELECT everywhere, plus INSERT on all but event_streams, plus
# UPDATE/DELETE only on the mutable tables. So: read-only on event_streams
# (the event log's sequence counter, which a database trigger maintains);
# append-only on events, run_messages, cost_entries, integration_actions,
# config_audit, redaction_log and human_actions; read/write on the rest. That is
# what makes the REVOKE bite even when the app connects as the database owner.
# The role is set in the connection's startup packet, so a pooler that rejects
# startup options (pgbouncer in transaction mode) needs this left empty and a
# login role that already carries the right grants.
APP_DB_APP_ROLE=platform_app
# Maximum pooled connections per process. The event dispatcher holds TWO at
# once per concurrent dispatch — the transaction that owns the event's queue row
# for the length of the dispatch, and the handler's transaction running inside
# it — so this must be at least 2 * APP_DISPATCH_MAX_CONCURRENCY + 1. Start-up
# refuses anything below that rather than deadlocking on it. That figure is the
# floor for dispatch alone, though: the same pool serves API queries and
# notifications, so size above it in a real deployment.
APP_DB_POOL_MAX=10
# How long a caller waits for a free pooled connection before failing. Without
# it the pg driver waits for ever, so a pool too small for the work in flight
# hangs silently instead of erroring. A failed dispatch leaves its event queued,
# so a bounded wait costs a retry, never an event.
APP_DB_CONNECTION_TIMEOUT_MS=10000
# How many months of monthly partitions to keep ahead of the current one. The
# migrate service and the daily maintenance job both use it.
APP_DB_PARTITION_MONTHS_AHEAD=3
# Transcript retention in days. Empty (the default) keeps everything forever;
# a value drops whole run_messages partitions older than it. Metadata,
# artifacts, events and cost are never dropped. This variable is the source of
# truth: migrate writes it into the database on every run, so editing the stored
# value by hand is reverted on the next start.
APP_TRANSCRIPT_RETENTION_DAYS=

# ── Event dispatch (TD-005, TD-014) ──────────────────────────────────────────
# Events an outbox sweep reads at a time. At most one per stream, so this bounds
# how many streams move in parallel, not how deep the queue is drained.
APP_DISPATCH_BATCH_SIZE=32
# Dispatches in flight at once. Each holds two pooled connections, so
# APP_DB_POOL_MAX must be at least 2 * this + 1 (the sweep needs one to read
# with). Raising it needs the pool raised with it.
APP_DISPATCH_MAX_CONCURRENCY=1
# Longest an idle worker waits before sweeping again. Every process runs this
# timer itself and always arms it: appending an event sends a NOTIFY that wakes
# that process's own subscription immediately, and this poll is the fallback for
# *that* subscription, so nothing cluster-wide (a cron job, another replica) can
# stand in for it. Raise it to cut idle queries, lower it if NOTIFY cannot reach
# this process. Every replica polls the one queue, which is cheap: the claim is
# FOR UPDATE SKIP LOCKED, so concurrent sweeps never block one another.
APP_DISPATCH_POLL_INTERVAL_MS=1000
# Retry backoff after a handler fails: the first retry waits this long, each
# further attempt twice as long, capped by the maximum. The event's whole stream
# waits behind it, which is what keeps effects ordered per stream.
APP_DISPATCH_RETRY_DELAY_MS=5000
APP_DISPATCH_MAX_RETRY_DELAY_MS=300000
# How long a graceful shutdown waits for in-flight dispatches before reporting
# what is still running. Nothing is dropped either way; an unfinished event stays
# queued for the next process.
APP_DISPATCH_DRAIN_TIMEOUT_MS=30000
# LISTEN/NOTIFY channel used for real-time fan-out between app instances. A bare
# lower-case identifier. Change it only to run two instances against one database.
APP_BROADCAST_CHANNEL=platform_broadcast

# ── Jobs, timers and cron (TD-004) ───────────────────────────────────────────
# pg-boss lives in the same database, in its own schema, installed by the
# migrate service. Change this only if migrate was run with a different schema:
# the runtime never installs or upgrades it (TD-019).
APP_JOBS_SCHEMA=pgboss
# How often a worker looks for work when nothing wakes it, in seconds.
# pg-boss's floor is 0.5.
APP_JOBS_POLL_INTERVAL_SECONDS=2
# How often the cron table is re-read, in seconds (1-45). Lower makes a newly
# registered schedule take effect sooner and costs one small query per interval.
APP_JOBS_CRON_INTERVAL_SECONDS=30

# ── Working calendar (question timeouts, reminders, digests) ─────────────────
# `1 working day` in .agentic/config.yml is resolved on this calendar (BD-006,
# Q8, Q36). It seeds the organisation setting; a project never overrides it,
# because working days are an organisational fact, not a repository one.
# The zone comes from TZ above and defaults to UTC — never to the host clock.
#
# ISO weekday numbers, Monday = 1 … Sunday = 7.
APP_WORKING_DAYS=1,2,3,4,5
# The window inside a working day, HH:MM-HH:MM, read in TZ.
APP_WORKING_HOURS=09:00-17:00
# Comma-separated YYYY-MM-DD dates with no working time. Empty by default: the
# platform never guesses a country's public holidays.
APP_HOLIDAYS=

# ── Claude ───────────────────────────────────────────────────────────────────
# Secret. Required in APP_PROVIDER_MODE=api. Passed only to the runner process.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
# Secret. Optional, APP_PROVIDER_MODE=local only.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_FILE=
# Set on runner processes.
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
DISABLE_AUTOUPDATER=1

# ── Integration credentials (tool-native names, TD-020) ──────────────────────
# All secret; all optional until the matching integration is configured.
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=
GITLAB_TOKEN_FILE=
JIRA_SITE=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_API_TOKEN_FILE=
SLACK_APP_TOKEN=
SLACK_APP_TOKEN_FILE=
SLACK_BOT_TOKEN=
SLACK_BOT_TOKEN_FILE=
SENTRY_AUTH_TOKEN=
SENTRY_AUTH_TOKEN_FILE=
LOKI_ADDR=

# ── CI budgets (used by evals.yml / nightly-llm.yml) ─────────────────────────
EVAL_MAX_USD=5
LLM_CI_MAX_USD=10

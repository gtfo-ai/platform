# The worker's **dev mode** settings (S-22.16) — `pnpm worker:dev` reads `.env.worker`.
#
#   cp .env.worker.example .env.worker && chmod 600 .env.worker
#
# `.env.worker` is git-ignored (`.env.*`); this example is the only copy that is committed, so it
# holds no real value (BD-002). It is compose's interpolation file for `compose.worker.yml` +
# `compose.worker.dev.yml`, not a container's environment: each variable reaches the worker only
# where one of those files names it. A **prod** worker (no clone, the core's own compose file) is
# the README's "Run a worker on your machine"; nothing here is for it.

# The core this worker claims runs from. Default: the local `pnpm dev` core on this machine, reached
# from the container through `host.docker.internal` (Docker Desktop resolves it; the dev override
# adds it on Linux, where the core must listen on an address the bridge reaches, e.g. HOST=0.0.0.0).
# Give that core a test project of its own: two installations polling one binding duplicate every
# action. Autix (`https://agentic.autix.eu`) works too.
APP_CORE_URL=http://host.docker.internal:8080

# Your Claude subscription token (`claude setup-token`, run yourself). Required. Write it with a
# silent prompt rather than an editor, so it is never printed:
#   read -rs T && printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$T" >> .env.worker && unset T
CLAUDE_CODE_OAUTH_TOKEN=

# Runs this worker takes at once.
APP_WORKER_CONCURRENCY=1
# Seconds a usage limit pauses this worker when the limit names no reset time (WP-285).
APP_WORKER_USAGE_PAUSE_DEFAULT=3600
LOG_LEVEL=info
# The worker's local page (`enabled` | `disabled`); disabled opens no port.
APP_WORKER_UI=enabled

# Left to `compose.worker.yml`'s defaults unless set: the git helper image (pinned there by digest)
# and the mirror helper's memory, in MB.
# APP_WORKSPACE_GIT_IMAGE=
# APP_WORKSPACE_MIRROR_MEMORY_MB=2048

# The dev worker's own names, so it runs beside a prod worker on the same daemon. The prod names
# (`APP_WORKER_UI_PORT`, `APP_WORKER_CONTROL_VOLUME`, `APP_WORKER_CACHE_VOLUME`,
# `APP_WORKER_RUN_NETWORK`) are ignored by dev mode on purpose.
# The local page's host port (the worker's own build of the page); a prod worker's is 7357.
APP_WORKER_DEV_UI_PORT=7358
APP_WORKER_DEV_CONTROL_VOLUME=agentic-worker-dev-ctl
APP_WORKER_DEV_CACHE_VOLUME=agentic-worker-dev-repo-cache
APP_WORKER_DEV_RUN_NETWORK=agentic-worker-dev-run-egress

# The updater (S-22.10) — off in dev mode (`pnpm worker:dev` never self-updates); read by a prod
# worker brought up with this file. Left to `compose.worker.yml`'s defaults unless set: the image
# repository and the workflow whose build attestations are trusted (a fork sets its own), a registry
# mirror (`host=origin`), how often the core is asked, and the apply's health bound in seconds.
# APP_TRUSTED_IMAGE_REPOSITORY=ghcr.io/gtfo-ai/platform
# APP_TRUSTED_BUILDER=gtfo-ai/platform/.github/workflows/image.yml@refs/heads/main
# APP_UPDATE_REGISTRY_ENDPOINTS=
# APP_UPDATE_POLL_SECONDS=300
# APP_UPDATE_CHECK_SECONDS=120

{
  "name": "platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Self-hosted platform that runs Claude Code agents through a delivery pipeline.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "verify": "node scripts/verify.mjs verify",
    "verify:static": "node scripts/verify.mjs verify:static",
    "verify:types": "node scripts/verify.mjs verify:types",
    "verify:bundle": "node scripts/verify.mjs verify:bundle",
    "verify:tests": "node scripts/verify.mjs verify:tests",
    "verify:integration": "node scripts/verify.mjs verify:integration",
    "verify:e2e": "node scripts/verify.mjs verify:e2e",
    "verify:ui": "node scripts/verify.mjs verify:ui",
    "verify:commits": "node scripts/commits.mjs",
    "verify:dco": "node scripts/commits.mjs dco",
    "verify:commitlint": "node scripts/commits.mjs commitlint",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project contract --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e-fake-claude",
    "test:ui": "vitest run --project ui",
    "dev": "node scripts/dev.mjs",
    "db:migrate": "node --import ./scripts/ts-source-resolver.mjs apps/server/src/migrate.ts",
    "schemas": "node scripts/schemas.mjs",
    "schemas:check": "node scripts/schemas.mjs --check",
    "ignored:check": "node scripts/check-ignored.mjs",
    "nul:check": "node scripts/check-nul.mjs",
    "conflict:check": "node scripts/check-conflict.mjs",
    "secrets:scan": "node scripts/gitleaks.mjs dir .",
    "secrets:scan:ci": "node scripts/gitleaks.mjs git --log-opts=--all --require",
    "secrets:scan:history": "node scripts/gitleaks.mjs git --log-opts=--all",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "test:web-e2e": "playwright test",
    "verify:web-e2e": "node scripts/verify.mjs verify:web-e2e"
  },
  "devDependencies": {
    "@b12k/gitleaks": "8.30.1-v.36",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@platform/application": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/domain": "workspace:*",
    "@platform/infrastructure": "workspace:*",
    "@platform/integrations": "workspace:*",
    "@platform/server": "workspace:*",
    "@platform/web": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-orm": "0.45.2",
    "fast-check": "4.9.0",
    "happy-dom": "20.14.0",
    "lefthook": "2.1.12",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}

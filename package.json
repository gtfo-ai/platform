{
  "name": "platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Self-hosted platform that runs Claude Code agents through a delivery pipeline.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "verify": "node scripts/verify.mjs verify",
    "verify:integration": "node scripts/verify.mjs verify:integration",
    "verify:e2e": "node scripts/verify.mjs verify:e2e",
    "verify:ui": "node scripts/verify.mjs verify:ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project contract --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e-fake-claude",
    "test:ui": "vitest run --project ui",
    "dev": "node scripts/dev.mjs",
    "schemas": "node scripts/schemas.mjs",
    "schemas:check": "node scripts/schemas.mjs --check",
    "secrets:scan": "node scripts/gitleaks.mjs dir .",
    "secrets:scan:ci": "node scripts/gitleaks.mjs git --log-opts=--all --require",
    "secrets:scan:history": "node scripts/gitleaks.mjs git --log-opts=--all"
  },
  "devDependencies": {
    "@b12k/gitleaks": "8.30.1-v.36",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "fast-check": "4.9.0",
    "happy-dom": "20.14.0",
    "lefthook": "2.1.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}

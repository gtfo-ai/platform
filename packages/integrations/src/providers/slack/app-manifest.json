{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Agentic",
    "description": "Runs Claude Code agents through your delivery pipeline and asks you when it needs a human.",
    "background_color": "#1f2933"
  },
  "features": {
    "bot_user": {
      "display_name": "Agentic",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "chat:write", "groups:history", "users:read", "users:read.email"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}

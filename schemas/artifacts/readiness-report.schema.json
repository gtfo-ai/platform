{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadinessReport data",
  "description": "Structured output of the stage that produces a ReadinessReport artifact (technical/12).",
  "type": "object",
  "properties": {
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          },
          "unlocks": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "passed",
          "evidence",
          "unlocks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "level",
    "criteria"
  ],
  "additionalProperties": false,
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewVerdict data",
  "description": "Structured output of the stage that produces a ReviewVerdict artifact (technical/12).",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      }
    },
    "summary": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "suspicious_inputs_noted": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "protected_path_changes_confirmed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PathPattern"
      }
    },
    "checklists_applied": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/Slug"
              },
              "item_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "required_by": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Slug"
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "item_count",
              "required_by",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "criteria": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "not_met",
                  "untestable"
                ]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved_threads": {
      "anyOf": [
        {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/anon_fff8dfda"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "verdict",
    "findings",
    "summary",
    "protected_path_changes_confirmed"
  ],
  "additionalProperties": false,
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "PathPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ReviewFinding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "category": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathPattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "suggestion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "explanation"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor",
        "nit"
      ]
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "anon_fff8dfda": {
      "maxLength": 255,
      "$ref": "#/$defs/NonEmptyString"
    }
  }
}

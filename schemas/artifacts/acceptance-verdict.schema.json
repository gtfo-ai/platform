{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcceptanceVerdict data",
  "description": "Structured output of the stage that produces a AcceptanceVerdict artifact (technical/12).",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "not_met",
              "untestable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "scope_creep": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "ux_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    }
  },
  "required": [
    "verdict",
    "criteria",
    "scope_creep",
    "missing",
    "ux_notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}

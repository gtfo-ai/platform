{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationNotes data",
  "description": "Structured output of the stage that produces a ImplementationNotes artifact (technical/12).",
  "type": "object",
  "properties": {
    "summary": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "deviations_from_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "why": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "required": [
          "what",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "tests_added": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "exit_code": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "followup_tickets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "mr": {
      "$ref": "#/$defs/MergeRequestRef"
    }
  },
  "required": [
    "summary",
    "deviations_from_plan",
    "tests_added",
    "commands_run",
    "known_gaps",
    "followup_tickets",
    "mr"
  ],
  "additionalProperties": false,
  "$defs": {
    "MergeRequestRef": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "iid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "url": {
          "$ref": "#/$defs/Url"
        },
        "branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_sha": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "iid",
        "url"
      ],
      "additionalProperties": false
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "Url": {
      "type": "string",
      "format": "uri"
    }
  }
}

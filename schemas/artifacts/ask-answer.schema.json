{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AskAnswer data",
  "description": "Structured output of the stage that produces a AskAnswer artifact (technical/12).",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "maxLength": 20000
    },
    "citations": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/anon_85f500a1"
      }
    },
    "unanswered": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/anon_204b72bd"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "required": [
    "answer",
    "citations",
    "unanswered",
    "confidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactType": {
      "type": "string",
      "enum": [
        "RefinedSpec",
        "RootCauseAnalysis",
        "ImplementationPlan",
        "ImplementationNotes",
        "ReviewVerdict",
        "AcceptanceVerdict",
        "RetroReport",
        "LibrarianProposals",
        "ShadowReport",
        "ReadinessReport",
        "DiscoveryDraft",
        "AskAnswer"
      ]
    },
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "anon_204b72bd": {
      "type": "string",
      "maxLength": 1000
    },
    "anon_85f500a1": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "run",
            "artifact",
            "audit",
            "knowledge"
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactType"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    }
  }
}

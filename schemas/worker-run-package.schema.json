{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker run package",
  "description": "One run as the core decided it and a remote worker executes it: the RunSpec without secret values, the WorkspaceSpec, the run credential, the skills, the image digests, the epoch and the run token (TD-031 decision 4). camelCase, a stated deviation; refinements (one run, no secret in an environment, the byte bound) are enforced by the zod schema only.",
  "type": "object",
  "properties": {
    "runId": {
      "$ref": "#/$defs/Id"
    },
    "epoch": {
      "$ref": "#/$defs/anon_03c948b9"
    },
    "runToken": {
      "$ref": "#/$defs/anon_ab1f2555"
    },
    "run": {
      "$ref": "#/$defs/anon_e7d1fded"
    },
    "workspace": {
      "$ref": "#/$defs/anon_2346d027"
    },
    "credential": {
      "$ref": "#/$defs/anon_e8af54fa"
    },
    "skills": {
      "$ref": "#/$defs/anon_e9ddba2d"
    },
    "images": {
      "$ref": "#/$defs/anon_16e0fe1d"
    },
    "limits": {
      "$ref": "#/$defs/anon_8b4b1efa"
    }
  },
  "required": [
    "runId",
    "epoch",
    "runToken",
    "run",
    "workspace",
    "credential",
    "skills",
    "images",
    "limits"
  ],
  "additionalProperties": false,

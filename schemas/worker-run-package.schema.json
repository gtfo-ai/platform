              "items": {
                "$ref": "#/$defs/anon_9374ac22"
              }
            },
            "connectPorts": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/anon_f2e5cf00"

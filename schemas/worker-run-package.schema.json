        "skills": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/anon_6d600f46"
          }
        },
        "protectedPaths": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathPattern"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "keepUntil": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "runletProtocol": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "runId",
        "projectId",
        "repo",
        "limits",
        "egress",
        "runtime",
        "readOnly",
        "skills",
        "protectedPaths",

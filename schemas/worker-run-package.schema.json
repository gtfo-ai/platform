    "AgentRole": {
      "type": "string",
      "enum": [
        "triager",
        "product_manager",
        "investigator",
        "architect",
        "developer",
        "reviewer",
        "acceptance_tester",
        "facilitator",
        "librarian",
        "discovery",
        "ask",
        "historian"
      ]
    },
    "ArtifactType": {
      "type": "string",
      "enum": [
        "RefinedSpec",
        "RootCauseAnalysis",
        "ImplementationPlan",
        "ImplementationNotes",
        "ReviewVerdict",
        "AcceptanceVerdict",
        "RetroReport",
        "LibrarianProposals",
        "ShadowReport",
        "ReadinessReport",
        "DiscoveryDraft",
        "AskAnswer",
        "HistoryFindings",
        "ResearchReport",
        "TicketBreakdown"
      ]
    },
    "Effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "JsonObject": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"

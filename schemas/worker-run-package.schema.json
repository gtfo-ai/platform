      "required": [
        "run",
        "egress"
      ],
      "additionalProperties": false
    },
    "anon_1c77b77c": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "anon_2346d027": {
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/Id"
        },
        "projectId": {
          "$ref": "#/$defs/Id"
        },
        "repo": {

          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "PathPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Usd": {
      "type": "number",

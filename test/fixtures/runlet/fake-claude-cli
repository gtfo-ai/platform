#!/usr/bin/env node
/**
 * A stand-in for the Claude Code CLI, as a **real executable**.
 *
 * `packages/infrastructure/src/runner/fake-spawn.ts` fakes the same protocol *in the test process*,
 * which is right for the SDK adapter's golden fixtures and wrong here: WP-13's subject is the
 * transport, so the CLI has to be a process the shim actually `execve`s, writing to a real pipe
 * that a real socket carries. Its divergence register says "no backpressure", and WP-12's review
 * closed with "WP-13 must not run its large stdout conformance test against this fake" — this file
 * is the answer to that.
 *
 * It speaks the least of the SDK's stream-json protocol that a `query()` needs:
 *
 *   1. answer the `initialize` control request with `success`;
 *   2. wait for the prompt (`{"type":"user"}`);
 *   3. emit `system/init`, an `assistant` message and a `result`, then exit 0.
 *
 * Everything it emits is fixed text with obviously fake numbers. Behaviour is chosen by argv:
 *
 *   --scenario success        the three messages above
 *   --scenario big-stdout     `--megabytes N` of filler on stdout before the result
 *   --scenario stderr         a line on stderr before the result
 *   --scenario signal-report  never finishes; reports the signals it receives on stdout
 *   --scenario ignore-term    never finishes and ignores SIGTERM (for the kill-on-disconnect test)
 *
 * `--pid-file <path>` writes its own pid, so a test can ask the operating system whether the child
 * is gone rather than believing a frame that says so.
 */
import { writeFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const flag = (name, fallback = null) => {
  const at = argv.indexOf(name);
  return at >= 0 && at + 1 < argv.length ? argv[at + 1] : fallback;
};

const scenario = flag('--scenario', 'success');
const pidFile = flag('--pid-file');
if (pidFile !== null) {
  writeFileSync(pidFile, String(process.pid));
}

const SESSION = 'fake-session-runlet';
/**
 * `end()` twice on stdout emits ERR_STREAM_ALREADY_FINISHED, and an unhandled error there takes
 * the process down **while its 16 MiB are still flushing** — which arrives at the other end as a
 * transport that lost 128 KiB. Found exactly that way, under a full-suite run.
 */
let stdoutEnded = false;
const endStdout = () => {
  if (!stdoutEnded) {
    stdoutEnded = true;
    process.stdout.end();
  }
};
const write = (message) => {
  process.stdout.write(`${JSON.stringify(message)}\n`);
};

const emitResult = () => {
  write({
    type: 'assistant',
    message: {
      id: 'msg_runlet_0001',
      type: 'message',
      role: 'assistant',
      model: 'claude-opus-5',
      content: [{ type: 'text', text: 'the shim carried this' }],
      stop_reason: 'end_turn',
      stop_sequence: null,
      usage: { input_tokens: 10, output_tokens: 5 },
    },
    parent_tool_use_id: null,
    uuid: '10000002-0000-4000-8000-000000000000',
    session_id: SESSION,
  });
  write({
    type: 'result',
    subtype: 'success',
    duration_ms: 12,
    duration_api_ms: 10,
    is_error: false,
    num_turns: 1,
    result: 'the shim carried this',
    stop_reason: 'end_turn',
    total_cost_usd: 0.01,
    usage: { input_tokens: 10, output_tokens: 5 },
    modelUsage: {},
    permission_denials: [],
    uuid: '10000003-0000-4000-8000-000000000000',
    session_id: SESSION,
  });
};

const start = () => {
  write({
    type: 'system',
    subtype: 'init',
    apiKeySource: 'ANTHROPIC_API_KEY',
    claude_code_version: '2.1.267',
    cwd: process.cwd(),
    tools: [],
    mcp_servers: [],
    model: 'claude-opus-5',
    permissionMode: 'default',
    slash_commands: [],
    output_style: 'default',
    skills: [],
    plugins: [],
    uuid: '10000001-0000-4000-8000-000000000000',
    session_id: SESSION,
  });

  if (scenario === 'big-stdout') {
    const megabytes = Number(flag('--megabytes', '16'));
    const block = Buffer.alloc(1024 * 1024, 97);
    for (let index = 0; index < megabytes; index += 1) {
      process.stdout.write(block);
    }
  }
  if (scenario === 'stderr') {
    process.stderr.write('a warning from the cli\n');
  }
  if (scenario === 'signal-report' || scenario === 'ignore-term') {
    return;
  }
  emitResult();
  // No `process.exit()`: it would discard whatever stdout still has buffered, which is a truncation
  // inside this process that looks exactly like a transport dropping bytes.
  endStdout();
};

if (scenario === 'signal-report') {
  for (const signal of ['SIGUSR1', 'SIGUSR2', 'SIGHUP', 'SIGINT']) {
    process.on(signal, () => {
      write({ type: 'system', subtype: 'signal', signal, session_id: SESSION });
    });
  }
  setInterval(() => {}, 1000);
}
if (scenario === 'ignore-term') {
  process.on('SIGTERM', () => {
    if (pidFile !== null) {
      writeFileSync(`${pidFile}.term`, 'term');
    }
  });
  setInterval(() => {}, 1000);
}

let buffered = '';
let started = false;
process.stdin.on('data', (chunk) => {
  buffered += chunk.toString('utf8');
  for (;;) {
    const newline = buffered.indexOf('\n');
    if (newline < 0) {
      return;
    }
    const line = buffered.slice(0, newline).trim();
    buffered = buffered.slice(newline + 1);
    if (line.length === 0) {
      continue;
    }
    let frame;
    try {
      frame = JSON.parse(line);
    } catch {
      continue;
    }
    if (frame.type === 'control_request') {
      write({
        type: 'control_response',
        response: { subtype: 'success', request_id: frame.request_id, response: {} },
      });
      continue;
    }
    if (frame.type === 'user' && !started) {
      started = true;
      start();
    }
  }
});

// The scenarios that never finish keep the process alive on their own timer; the rest end when
// stdin closes, exactly as the real CLI's graceful-exit path does.
process.stdin.on('end', () => {
  if (scenario !== 'signal-report' && scenario !== 'ignore-term') {
    endStdout();
  }
});

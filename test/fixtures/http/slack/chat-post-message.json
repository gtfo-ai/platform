    },
    {
      "method": "POST",
      "path": "/chat.postMessage",
      "match": { "channel": "C0FAKEMISS1" },
      "status": 200,
      "body": { "ok": false, "error": "channel_not_found" },
      "source": {
        "url": "https://docs.slack.dev/reference/methods/chat.postMessage",
        "retrieved": "2026-09-10",
        "kind": "documented-adapted",
        "note": "`channel_not_found` is listed among the method's error codes and the Web API's error envelope is `{ok: false, error}`; the page prints no example of the failure body, so the body is assembled from those two documented facts. The status is 200 — the whole reason the adapter maps the error string rather than the status."
      }
    },
    {
      "method": "POST",
      "path": "/chat.postMessage",
      "match": { "channel": "C0FAKEBLOCK" },
      "status": 200,
      "body": { "ok": false, "error": "invalid_blocks" },
      "source": {
        "url": "https://docs.slack.dev/reference/methods/chat.postMessage",
        "retrieved": "2026-09-10",
        "kind": "documented-adapted",
        "note": "`invalid_blocks` is listed among the method's error codes; the body is the documented error envelope. This is the answer the adapter's own Block Kit validation exists to make unreachable, and it is recorded so the mapping is exercised anyway."
      }
    }

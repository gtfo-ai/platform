      },
      "status": 200,
      "body": {
        "ok": true,
        "channel": "C0FAKECHAN1",
        "ts": "1780000002.000300"
      },
      "source": {
        "url": "https://docs.slack.dev/reference/methods/chat.postMessage",
        "retrieved": "2026-09-10",
        "kind": "documented-adapted",
        "note": "The example response reduced to the three members the adapter reads. `message` is documented as part of the response and is omitted here to record that nothing depends on it."
      }
    },
    {
      "method": "POST",
      "path": "/chat.postMessage",
